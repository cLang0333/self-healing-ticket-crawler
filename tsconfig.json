{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["playwright.config.ts", "selectors/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
